{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "komkrip",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "komkrip",
      "database_id": "ddde0b8d-a419-40c6-bd43-0511f13dc4ce",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "BOOK_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } },
    { "name": "LOOKUP_LIMITER", "namespace_id": "1003", "simple": { "limit": 12, "period": 60 } }
  ],
  "vars": { "DEMO": "1" },
  // 03:00 Asia/Bangkok — wipe and re-seed the public demo every night
  "triggers": { "crons": ["0 20 * * *"] }
}
